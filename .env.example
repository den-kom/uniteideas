# --- server ---
HOST=0.0.0.0
PORT=8100
# The canonical address of this site, used for magic-link URLs and proof bundles,
# so it must be reachable from your browser. REQUIRED in production: when it is
# unset the address is taken from the request, which is only accepted on a private
# address because the Host header is client-controlled. Leaving it unset is how a
# branch preview on its own port gets working sign-in links.
PUBLIC_BASE_URL=http://10.0.0.5:8100

# --- secrets ---
# Signs session cookies AND derives the sealed-detail encryption key.
# Changing it logs everyone out and makes existing sealed text unreadable.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-me

# Bearer token the Agent System uses on /api/agent/*
AGENT_API_TOKEN=replace-me

# --- storage ---
DB_PATH=data/uniteideas.db
UPLOAD_DIR=data/uploads
OUTBOX_DIR=data/outbox
# Set DATABASE_URL to override SQLite entirely (e.g. Postgres in phase 2).
# DATABASE_URL=postgresql+psycopg://user:pass@host/uniteideas

# --- auth ---
MAGIC_LINK_TTL_MINUTES=30
# Dev only: shows the sign-in link on screen because no SMTP is configured.
DEV_SHOW_MAGIC_LINK=true

# --- collaboration ---
# Total hours/week a single account can pledge across every project it joins.
MAX_PLEDGE_HOURS_PER_WEEK=40
# Above this, the UI warns that it is a heavy commitment.
SOFT_PLEDGE_HOURS_PER_WEEK=20
